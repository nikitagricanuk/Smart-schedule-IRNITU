TG_TOKEN=

VK_TOKEN=

PG_DB_DATABASE=schedule
PG_DB_USER=
PG_DB_PASSWORD=
PG_DB_HOST=
EXAMS_API=
SCHEDULE_SOURCE=istu_website

# Публичный адрес, по которому календарные приложения (Google/Apple Calendar
# и т.п.) будут забирать .ics-файлы у calendar_service. Должен указывать на
# reverse-proxy/домен перед calendar_service.
CALENDAR_PUBLIC_BASE_URL=http://localhost:8091
# Куда публиковать calendar_service на хосте. Можно указать интерфейс, чтобы
# наружу отдавал только nginx, напр. 127.0.0.1:8091 (см. deploy/nginx.schedule.conf).
CALENDAR_SERVICE_PORT=127.0.0.1:8091
